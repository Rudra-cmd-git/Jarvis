{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "tests/**/*.ts",
    "src/shared/**/*.ts",
    "src/main/utils/ipc-guard.ts",
    "src/renderer/navigation.ts"
  ]
}
